{
  "name": "@dipeshgavit666/readme-ai",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "description": "AI-powered CLI that reads your codebase and generates your README automatically.",
  "author": "dipeshgavit666",
  "license": "MIT",
  "keywords": [
    "readme",
    "ai",
    "cli",
    "documentation",
    "generator",
    "gemini",
    "anthropic",
    "openai"
  ],
  "bin": {
    "readme-ai": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@google/genai": "^1.46.0"
  }
}
