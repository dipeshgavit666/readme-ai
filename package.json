{
  "name": "readme-ai",
  "module": "index.ts",
  "type": "module",
  "description": "AI-powered CLI that reads your codebase and generates your README automatically.",
  "bin": {
    "readme-ai": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@google/genai": "^1.46.0"
  }
}
